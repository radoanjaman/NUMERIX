# ==============================================================================
# NUMERIX Git Ignore Rules
# Covers: Python (Core & FastAPI), Node.js / Next.js, IDEs, and OS artifacts
# ==============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# --- Python Build / Venv Libs (Do not ignore frontend src/lib) ---
/lib/
/lib64/
MAIN/lib/
MAIN/lib64/
!**/src/lib/**
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.tox/

# --- Node.js & Next.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
.pnp
.pnp.js

# Next.js Build Output
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# --- Environment & Secret Keys ---
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# (Keep example environment configs committed)
!.env.example

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- IDEs & Code Editors ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.code-workspace

# --- Temporary Archives & Scratch Files ---
*.zip
*.tar.gz
*.bak
*.tmp
*.log
scratch/
